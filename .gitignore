# ==============================================================================
# CloudCampus Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Production / Build outputs
dist/
build/
out/
.vite/
.next/
.nuxt/
.svelte-kit/

# Testing & Coverage
coverage/
*.lcov

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Local Uploads & Temporary Data
backend/uploads/*
!backend/uploads/.gitkeep
archive/
../CloudCampus-Archive/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & OS Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache
.DS_Store
Thumbs.db

# Database Binaries & Archives
*.sqlite
*.db
pgsql/
bin/
tectonic.zip
*.zip
